# MySQL / MariaDB configuration for the app
# Copy to .env and update values for your local XAMPP database.
DATABASE_URL=mysql+pymysql://root:@localhost:3306/inventory_management?charset=utf8mb4

# Optional fallback if DATABASE_URL is unset:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=inventory_management
# DB_USER=root
# DB_PASSWORD=
